# Public URL of the deployed site, base path included (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.ch

# Optional: form delivery endpoint (POST JSON). Leave empty to prepare an e-mail instead.
NEXT_PUBLIC_FORM_ENDPOINT=

# Allow search engines to index the site (only for the launch approved by the club)
NEXT_PUBLIC_INDEXABLE=false

# Static HTML export into out/ (no Node.js server), and optional sub-path
STATIC_EXPORT=
NEXT_PUBLIC_BASE_PATH=
